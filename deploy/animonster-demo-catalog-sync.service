[Unit]
Description=Synchronize AniMonster published video catalog
After=network-online.target

[Service]
Type=oneshot
User=animonster-catalog
ExecStart=/usr/bin/python3 /opt/animonster-media/demo-catalog-sync.py
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/animonster-media
MemoryMax=128M
