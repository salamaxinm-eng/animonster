[Unit]
Description=AniMonster VPN access agent
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
EnvironmentFile=/opt/animonster-vpn/secrets/agent.env
ExecStart=/usr/bin/python3 /opt/animonster-vpn/deploy/vpn-agent.py
Restart=always
RestartSec=10
User=root
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/animonster-vpn
PrivateTmp=true

[Install]
WantedBy=multi-user.target
