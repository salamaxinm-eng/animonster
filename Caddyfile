{$SITE_ADDRESS:http://31.77.10.81} {
  encode zstd gzip
  # Limit abusive clients before requests reach either Next.js node.
  # A generous site limit allows normal asset loading and video playback.
  rate_limit {
    zone site {
      key {remote_host}
      window 1m
      events 1200
      ipv6_prefix 64
    }
    zone site_burst {
      key {remote_host}
      window 1s
      events 180
      ipv6_prefix 64
    }
    zone api {
      match {
        path /api/*
        # Image GETs have separate limits from application actions.
        not path /api/image /api/avatar/* /api/plus-assets/* /api/battlepass/assets/* /api/cosmetic-generator/assets/*
      }
      key {remote_host}
      window 1m
      events 360
      ipv6_prefix 64
    }
    zone api_burst {
      match {
        path /api/*
        not path /api/image /api/avatar/* /api/plus-assets/* /api/battlepass/assets/* /api/cosmetic-generator/assets/*
      }
      key {remote_host}
      window 1s
      events 24
      ipv6_prefix 64
    }
    zone images {
      match {
        path /api/image /api/avatar/* /api/plus-assets/* /api/battlepass/assets/* /api/cosmetic-generator/assets/*
        method GET
      }
      key {remote_host}
      window 1m
      events 900
      ipv6_prefix 64
    }
    zone images_burst {
      match {
        path /api/image /api/avatar/* /api/plus-assets/* /api/battlepass/assets/* /api/cosmetic-generator/assets/*
        method GET
      }
      key {remote_host}
      window 1s
      events 90
      ipv6_prefix 64
    }
    zone auth {
      match {
        path /api/auth/*
      }
      key {remote_host}
      window 1m
      events 30
      ipv6_prefix 64
    }
    zone search {
      match {
        path /api/search /api/search/*
      }
      key {remote_host}
      window 1m
      events 90
      ipv6_prefix 64
    }
  }
  reverse_proxy app:3000 {
    lb_policy cookie animonster_node
    health_uri /api/health
    health_interval 10s
    health_timeout 3s
    fail_duration 30s
  }
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    -Server
  }
  log {
    output stdout
    format json
  }
}

# Mail.ru checks the verification URL over plain HTTP and requires 200.
http://animonster.su {
  handle /mailru-domainuoEN7dmyLT3J0c0x.html {
    root * /srv/verification
    file_server
  }
  handle {
    redir https://animonster.su{uri} 308
  }
}
